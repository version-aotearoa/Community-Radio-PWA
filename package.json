{
	"name": "version-radio",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"cf:types": "wrangler types --env-interface CloudflareBindings",
		"pages:dev": "npm run build && wrangler pages dev .svelte-kit/cloudflare",
		"pages:deploy": "npm run build && cd deploy/staging && wrangler pages deploy ../../.svelte-kit/cloudflare --project-name version-radio-staging",
		"pages:deploy:prod": "npm run build && wrangler pages deploy .svelte-kit/cloudflare --project-name version-radio"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260826.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/sanitize-html": "^2.16.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"wrangler": "^4.126.0"
	},
	"dependencies": {
		"@fontsource/anton": "^5.3.0",
		"@fontsource/hanken-grotesk": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@friendofsvelte/tipex": "^0.2.0",
		"@svar-ui/svelte-core": "^2.6.0",
		"@svar-ui/svelte-grid": "^2.7.2",
		"better-auth": "^1.7.1",
		"hls.js": "^1.7.1",
		"sanitize-html": "^2.17.7",
		"sharp": "^0.35.2"
	}
}
